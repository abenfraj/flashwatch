{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "flashwatch\\.vercel\\.app" }],
      "destination": "https://flashwatch.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "flashwatch\\.vercel\\.app" }],
      "destination": "https://flashwatch.app/:path*",
      "permanent": true
    }
  ]
}
